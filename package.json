{
    "name": "vs-delimiter",
    "displayName": "vs-delimiter",
    "description": "Simple tool for splitting strings highlighted by your cursor",
    "publisher": "morber11",
    "version": "1.2.1",
    "engines": {
        "vscode": "^1.116.0"
    },
    "categories": [
        "Formatters"
    ],
    "activationEvents": [
        "onCommand:vs-delimiter.delimit",
        "onCommand:vs-delimiter.wrap",
        "onCommand:vs-delimiter.wrapanddelimit"
    ],
    "main": "./out/extension.js",
    "icon": "icon.jpg",
    "repository": {
        "type": "git",
        "url": "https://github.com/morber11/vs-delimiter"
    },
    "contributes": {
        "commands": [
            {
                "command": "vs-delimiter.delimit",
                "title": "Delimit"
            },
            {
                "command": "vs-delimiter.wrap",
                "title": "Wrap"
            },
            {
                "command": "vs-delimiter.wrapanddelimit",
                "title": "Wrap and Delimit"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Delimiter configuration",
            "properties": {
                "vs-delimiter.delimiter": {
                    "type": [
                        "string"
                    ],
                    "default": ",",
                    "description": "Specifies the default Delimiter to use."
                },
                "vs-delimiter.wrapper": {
                    "type": [
                        "string"
                    ],
                    "default": "'",
                    "description": "Specifies the default Wrapper to use."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test:unit": "npm run compile && mocha --ui tdd ./out/test/suite/transform.test.js",
        "test": "node ./out/test/runTest.js"
    },
    "overrides": {
        "mocha": {
            "diff": "^9.0.0",
            "serialize-javascript": "^7.0.5"
        }
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.1",
        "@types/node": "^25.6.0",
        "@types/vscode": "^1.116.0",
        "@typescript-eslint/eslint-plugin": "^8.59.0",
        "@typescript-eslint/parser": "^8.59.0",
        "@vscode/test-electron": "^2.3.2",
        "eslint": "^10.2.1",
        "glob": "^13.0.6",
        "mocha": "^11.7.5",
        "typescript": "^6.0.3"
    }
}